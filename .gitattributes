# Preserve source/provenance bytes and checksums on every operating system.
* -text

*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text

# The live Blue RL checkpoint fingerprints these exact configuration bytes.
RL/BlueTeam/DefaultTrainingConfig.json text eol=lf

# Container entrypoints run under Linux; a CRLF shebang breaks them. These are
# new tooling files, not provenance-hashed source or scanned assets.
*.sh text eol=lf
Dockerfile text eol=lf
docker/Dockerfile.unreal text eol=lf
