      "Enabled": false
    },
    {
      "Name": "InterchangeTests",
      "Enabled": false
    },
    {
      "Name": "USDCore",
      "Enabled": false
    },
    {
      "Name": "GLTFExporter",
      "Enabled": false
    },
    {
      "Name": "Fab",
      "Enabled": false
    },
    {
      "Name": "CesiumForUnreal",
